<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Afrocoiffure – Coiffeurs afro en Belgique{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Trouvez un coiffeur afro près de chez vous en Belgique : tresses, locks, tissages, coupes. Comparez les prix, les avis et les réalisations.{% endblock %}">
        <meta name="theme-color" content="#2B1A10">
        <link rel="icon" href="{{ asset('images/icone.svg') }}" type="image/svg+xml">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <a class="skip-link" href="#contenu">Aller au contenu</a>

        {{ include('partials/_header.html.twig') }}

        <main id="contenu">
            {{ include('partials/_flashes.html.twig') }}
            {% block body %}{% endblock %}
        </main>

        {{ include('partials/_footer.html.twig') }}
    </body>
</html>
